# ============================================================================
#  WasFit — configuração Apache (Hostinger, cPanel, etc.)
#  HTTPS + www->raiz + cache + compressão + cabeçalhos de segurança.
# ============================================================================

RewriteEngine On

# --- Força HTTPS ---
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- www.wasfit.com.br -> wasfit.com.br  (301 permanente) ---
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# --- Não servir arquivos internos / de config ---
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(md|internal|toml|yml|yaml|production|bak|log)$|^_redirects$|^_headers$)">
    Require all denied
  </FilesMatch>
</IfModule>
# /servicos/ saiu do ar em 08/09/2026: o escopo e o valor saem da reuniao de raio-x
RedirectMatch 301 ^/servicos/?$ /

RedirectMatch 404 /\.git
RedirectMatch 404 /_arquivo
Options -Indexes
ServerSignature Off

# --- Compressão ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

# --- Cache dos estáticos (assets versionáveis por ?v=) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Cabeçalhos de segurança ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(self), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(self), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()"
  # CSP: espelha a <meta> das páginas. Ao ativar GTM/GA, acrescente
  #   script-src  ... https://www.googletagmanager.com
  #   connect-src ... https://www.google-analytics.com https://www.googletagmanager.com
  #   img-src     ... https://www.google-analytics.com https://www.googletagmanager.com
  # Ao definir contato.formEndpoint, acrescente o host dele em connect-src.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-Hg1a4n1Ywa1JbUXFk9h5HvqunCRBdX+SGUEdU36X3bc=' 'sha256-djPdT5J1kuWFwawDhtbzz0YHt/63i3CUBG3CyUjLa4c=' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-c9rRax9D57fLqXzv61Ch392ImVY3VQHrNKcuah7lC2o=' 'sha256-uuMEqQMblMfuiu3Q+Td+sf6xbR6KL6vkmW8VdthNRbc=' 'sha256-XlXghU+xlMp/KNKjrvnIkC4hwlKeLUG/cxR0xhMvv9M=' 'sha256-8SzQWASgseuFeRUD7hmIwMR7tIG97Q2i7gg5dK7fVPw='; connect-src 'self' https://script.google.com https://v1.api.wasfit.com.br; media-src 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
  # Fontes podem ser lidas de qualquer origem (não têm dado sensível)
  <FilesMatch "\.(woff2|png|jpe?g|webp|svg|ico)$">
    Header set Cross-Origin-Resource-Policy "cross-origin"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
